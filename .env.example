PORT=3000
# development | production | test
NODE_ENV=development

# Orígenes del frontend permitidos por CORS, separados por coma.
# En desarrollo, si se deja vacío, se permite http://localhost:5173.
FRONTEND_URL=http://localhost:5173
# URL pública del frontend (enlaces de correo y retorno de Flow). Por defecto, el primer FRONTEND_URL.
FRONTEND_PUBLIC_URL=
# URL pública de esta API, sin /api (Flow envía aquí la confirmación de pago). Ej: https://api.statshub.cl
API_PUBLIC_URL=
# Detrás de Nginx/ALB: número de proxies de confianza (para la IP real del cliente). Ej: 1
TRUST_PROXY=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=statshub_deportivo
DB_USER=postgres
DB_PASSWORD=<tu_contraseña>
# Amazon RDS exige conexión cifrada. Certificado de AWS:
# https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DB_SSL=false
DB_SSL_CA=
# Alternativa: una sola URL de conexión (tiene prioridad sobre DB_*).
# En Railway, en el servicio del backend: DATABASE_URL=${{Postgres.DATABASE_URL}} (red privada, sin SSL).
# DATABASE_URL=postgres://usuario:contraseña@localhost:5432/statshub_deportivo

# Obligatorio (mínimo 32 caracteres). El servidor no arranca sin él.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Escudos de equipos (WebP). Por defecto ./uploads
UPLOADS_DIR=

# Zona horaria de la liga (regla "el acta se abre el día del partido").
TZ_LIGA=America/Santiago

# Servicio de Machine Learning (ml-service/). Sin él se usa el modelo de Poisson local.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=3000

# Correo (recuperación de contraseña). Sin SMTP_HOST, los correos se escriben en la consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=StatsHub Deportivo <no-responder@statshub.cl>

# Pasarela de pagos Flow. Sandbox: https://sandbox.flow.cl/api  ·  Producción: https://www.flow.cl/api
FLOW_API_URL=https://sandbox.flow.cl/api
FLOW_API_KEY=
FLOW_SECRET_KEY=

# Solo para `npm run create-admin` (crea o actualiza el usuario administrador).
# No dejes estos valores en el .env después de usarlos.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Admin
ADMIN_APELLIDO=StatsHub
